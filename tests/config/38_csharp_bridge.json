              ]
            }
          },
          {
            "id": "get_bad_runtime",
            "tool": "csharp_get_property",
            "args": { "path": "CSharpBridgeProbe", "property": "ReadOnlyName", "runtime": "editorial" },
            "expect": {
              "has_keys": ["error"],
              "field_checks": [
                { "key": "error", "value": "runtime must be \"editor\" or \"game\" for csharp_get_property" }
              ]
            }
          },
          {
            "id": "get_unknown_param",
            "tool": "csharp_get_property",
            "args": { "path": "CSharpBridgeProbe", "property": "ReadOnlyName", "bogus": 1 },
            "expect": {
              "has_keys": ["error"],
              "field_checks": [
                { "key": "error", "value": "unknown parameter for csharp_get_property: bogus" }
              ]
            }
          },
          {
