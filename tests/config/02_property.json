{
  "name": "property_tools",
  "description": "T3.3 迁移自 tests/integration/property_tools_test.cpp 的 11 个 TEST_F（PropertyToolsTest）：property_get/set/get_list 的返回结构、错误措辞、readback MATCHED、int 字符串静默转 0、缺参报错。节点选型 Label（Control 子类），规避 set_main_screen_editor 调用。本轮新增：临时脚本导出的 Node 引用属性（路径字符串转换 + converted_node_path 回执，坏路径报错）、typed 数组元素级转换（Array[Node2D] 接受路径字符串与 {\"__node_ref__\": 路径}，Array[PackedScene] 接受 res:// 路径；坏元素与非数组值报错）、property_get_list 的 only_script_variables / property_filter 过滤行为。fixture 位于 res://gda_tmp_prop_refs/，cleanup 阶段回收。",
  "headless": true,
  "pipeline": {
    "on_failure": "continue",
    "before_all": [
      {
        "id": "new_scene",
        "tool": "create_editor_scene",
        "args": { "name": "Root" }
      },
      {
        "id": "create_label_node",
        "tool": "create_scene_node",
        "args": { "name": "LabelNode", "type": "Label", "parent_path": "Root" }
      }
    ],
    "stages": [
      {
        "id": "main",
        "steps": [
          {
            "id": "property_get_int",
            "tool": "property_set",
            "args": { "path": "LabelNode", "property": "z_index", "value": 5 },
            "expect": {
              "field_checks": [ { "key": "result", "value": "ok" } ]
            }
          },
          {
            "id": "property_get_int_read",
            "tool": "property_get",
            "args": { "path": "LabelNode", "property": "z_index" },
            "expect": {
              "field_checks": [ { "key": "result", "value": 5 } ]
            }
          },
          {
            "id": "property_set_get_string",
            "tool": "property_set",
            "args": { "path": "LabelNode", "property": "text", "value": "Hello GDA" },
            "expect": {
              "field_checks": [ { "key": "result", "value": "ok" } ]
            }
          },
          {
            "id": "property_get_string_read",
            "tool": "property_get",
            "args": { "path": "LabelNode", "property": "text" },
            "expect": {
              "field_checks": [ { "key": "result", "value": "Hello GDA" } ]
            }
          },
          {
            "id": "property_set_vector2",
            "tool": "property_set",
            "args": { "path": "LabelNode", "property": "position", "value": { "x": 12.5, "y": -3.25 } },
            "expect": {
              "field_checks": [ { "key": "result", "value": "ok" } ]
            }
          },
          {
            "id": "property_get_vector2_read",
            "tool": "property_get",
            "args": { "path": "LabelNode", "property": "position" },
            "expect": {
              "field_checks": [
                { "key": "result.x", "value": 12.5 },
                { "key": "result.y", "value": -3.25 }
              ]
            }
          },
          {
            "id": "property_set_color",
            "tool": "property_set",
            "args": { "path": "LabelNode", "property": "modulate", "value": { "r": 1, "g": 0.5, "b": 0.25, "a": 1 } },
            "expect": {
              "field_checks": [ { "key": "result", "value": "ok" } ]
            }
          },
          {
            "id": "property_get_color_read",
            "tool": "property_get",
            "args": { "path": "LabelNode", "property": "modulate" },
            "expect": {
              "field_checks": [
                { "key": "result.r", "value": 1 },
                { "key": "result.g", "value": 0.5 },
                { "key": "result.b", "value": 0.25 },
                { "key": "result.a", "value": 1 }
              ]
            }
          },
          {
            "id": "property_get_missing_property",
            "tool": "property_get",
            "args": { "path": "LabelNode", "property": "no_such_prop" },
            "expect": {
              "field_checks": [
                { "key": "error", "value": "property not found: no_such_prop on node LabelNode — use property_get_list to see available properties" }
              ]
            }
          },
          {
            "id": "property_set_nonexistent_property",
            "tool": "property_set",
            "args": { "path": "LabelNode", "property": "no_such_prop", "value": 1 },
            "expect": {
              "field_checks": [ { "key": "error", "not_empty": true } ]
            }
          },
          {
            "id": "property_get_missing_node",
            "tool": "property_get",
            "args": { "path": "NoSuchNode", "property": "z_index" },
            "expect": {
              "field_checks": [
                { "key": "error", "value": "node not found: NoSuchNode — 当前场景根为 \"Root\"；合法路径写法：Root/子路径、/root/Root/子路径、子路径" }
              ]
            }
          },
          {
            "id": "property_set_missing_node",
            "tool": "property_set",
            "args": { "path": "NoSuchNode", "property": "z_index", "value": 5 },
            "expect": {
              "field_checks": [
                { "key": "error", "value": "node not found: NoSuchNode — 当前场景根为 \"Root\"；合法路径写法：Root/子路径、/root/Root/子路径、子路径" }
              ]
            }
          },
          {
            "id": "readback_matched_set",
            "tool": "property_set",
            "args": { "path": "Root", "property": "name", "value": "My Root" },
            "expect": {
              "field_checks": [ { "key": "result", "value": "ok" } ]
            }
          },
          {
            "id": "readback_matched_get",
            "tool": "property_get",
            "args": { "path": "My Root", "property": "name" },
            "expect": {
              "field_checks": [ { "key": "result", "value": "My Root" } ]
            }
          },
          {
            "id": "property_set_int_as_string",
            "tool": "property_set",
            "args": { "path": "LabelNode", "property": "z_index", "value": "abc" },
            "expect": {
              "field_checks": [ { "key": "result", "value": "ok" } ]
            }
          },
          {
            "id": "property_get_list",
            "tool": "property_get_list",
            "args": { "path": "LabelNode" },
            "expect": {
              "has_keys": [ "result" ],
              "field_checks": [ { "key": "result", "not_empty": true } ]
            }
          },
          {
            "id": "property_set_missing_value_param",
            "tool": "property_set",
            "args": { "path": "LabelNode", "property": "z_index" },
            "expect": {
              "field_checks": [ { "key": "error", "value": "missing required parameter: value" } ]
            }
          }
        ]
      },
      {
        "id": "script_property_refs",
        "steps": [
          {
            "id": "prop_fixture_script_created",
            "tool": "create_script",
            "args": {
              "path": "res://gda_tmp_prop_refs/prop_export_probe.gd",
              "overwrite": true,
              "source_code": "@tool\nextends Node\n\n@export var node_link: Node2D\n@export var node_list: Array[Node2D]\n@export var packed_list: Array[PackedScene]\n"
            },
            "expect": {
              "has_keys": ["result"],
              "field_checks": [
                { "key": "result.path", "value": "res://gda_tmp_prop_refs/prop_export_probe.gd" },
                { "key": "result.verified", "value": true }
              ]
            }
          },
          {
            "id": "prop_fixture_host_created",
            "tool": "create_scene_node",
            "args": { "name": "PropHost", "type": "Node", "parent_path": "LabelNode" },
            "expect": {
              "field_checks": [ { "key": "result.path", "value": "LabelNode/PropHost" } ]
            }
          },
          {
            "id": "prop_fixture_target_created",
            "tool": "create_scene_node",
            "args": { "name": "PropTarget", "type": "Node2D", "parent_path": "LabelNode" },
            "expect": {
              "field_checks": [ { "key": "result.path", "value": "LabelNode/PropTarget" } ]
            }
          },
          {
            "id": "prop_fixture_script_attached",
            "tool": "attach_script_to_node",
            "args": { "node_path": "LabelNode/PropHost", "script_path": "res://gda_tmp_prop_refs/prop_export_probe.gd" },
            "expect": {
              "field_checks": [
                { "key": "result", "value": "script attached to LabelNode/PropHost" },
                { "key": "instantiated", "value": true }
              ]
            }
          },
          {
            "id": "node_ref_set_ok",
            "tool": "property_set",
            "args": { "path": "LabelNode/PropHost", "property": "node_link", "value": "LabelNode/PropTarget" },
            "expect": {
              "field_checks": [
                { "key": "result", "value": "ok" },
                { "key": "converted_node_path", "value": "LabelNode/PropTarget" }
              ]
            }
          },
          {
            "id": "node_ref_get",
            "tool": "property_get",
            "args": { "path": "LabelNode/PropHost", "property": "node_link" },
            "expect": {
              "field_checks": [ { "key": "result.class", "value": "Node2D" } ]
            }
          },
          {
            "id": "node_ref_set_bad_path",
            "tool": "property_set",
            "args": { "path": "LabelNode/PropHost", "property": "node_link", "value": "LabelNode/NoSuchNode" },
            "expect": {
              "field_checks": [ { "key": "error", "not_empty": true } ]
            }
          },
          {
            "id": "node_array_set_ok",
            "tool": "property_set",
            "args": { "path": "LabelNode/PropHost", "property": "node_list", "value": ["LabelNode/PropTarget"] },
            "expect": {
              "field_checks": [ { "key": "result", "value": "ok" } ]
            }
          },
          {
            "id": "node_array_obj_ref_set_ok",
            "tool": "property_set",
            "args": { "path": "LabelNode/PropHost", "property": "node_list", "value": [ { "__node_ref__": "LabelNode/PropTarget" } ] },
            "expect": {
              "field_checks": [ { "key": "result", "value": "ok" } ]
            }
          },
          {
            "id": "node_array_set_bad_element",
            "tool": "property_set",
            "args": { "path": "LabelNode/PropHost", "property": "node_list", "value": ["LabelNode/NoSuchNode"] },
            "expect": {
              "field_checks": [ { "key": "error", "not_empty": true } ]
            }
          },
          {
            "id": "node_array_set_unsupported_element",
            "tool": "property_set",
            "args": { "path": "LabelNode/PropHost", "property": "node_list", "value": [42] },
            "expect": {
              "field_checks": [ { "key": "error", "not_empty": true } ]
            }
          },
          {
            "id": "node_array_set_non_array_value",
            "tool": "property_set",
            "args": { "path": "LabelNode/PropHost", "property": "node_list", "value": "not_an_array" },
            "expect": {
              "field_checks": [
                { "key": "error", "value": "value for array property 'node_list' on LabelNode/PropHost is not a JSON array; refusing to write (a non-array value would silently clear the array) — position: LabelNode/PropHost — expected: a JSON array — action: pass an array, e.g. [] to clear it explicitly, or a list of convertible elements" }
              ]
            }
          },
          {
            "id": "packed_fixture_written",
            "tool": "write_file",
            "args": {
              "path": "res://gda_tmp_prop_refs/packed_probe.tscn",
              "content": "[gd_scene format=3]\n\n[node name=\"PackedProbe\" type=\"Node\"]\n"
            },
            "expect": {
              "field_checks": [ { "key": "result", "value": "ok" } ]
            }
          },
          {
            "id": "packed_array_set_ok",
            "tool": "property_set",
            "args": { "path": "LabelNode/PropHost", "property": "packed_list", "value": ["res://gda_tmp_prop_refs/packed_probe.tscn"] },
            "expect": {
              "field_checks": [ { "key": "result", "value": "ok" } ]
            }
          },
          {
            "id": "packed_array_set_bad_path",
            "tool": "property_set",
            "args": { "path": "LabelNode/PropHost", "property": "packed_list", "value": ["res://gda_tmp_prop_refs/absent_packed.tscn"] },
            "expect": {
              "field_checks": [ { "key": "error", "not_empty": true } ]
            }
          },
          {
            "id": "packed_array_set_bad_shape",
            "tool": "property_set",
            "args": { "path": "LabelNode/PropHost", "property": "packed_list", "value": [ { "bogus": true } ] },
            "expect": {
              "field_checks": [ { "key": "error", "not_empty": true } ]
            }
          },
          {
            "id": "get_list_script_vars_only",
            "tool": "property_get_list",
            "args": { "path": "LabelNode/PropHost", "only_script_variables": true },
            "expect": {
              "has_keys": ["result"],
              "field_checks": [ { "key": "result", "not_empty": true } ]
            }
          },
          {
            "id": "get_list_script_vars_filter_hit",
            "tool": "property_get_list",
            "args": { "path": "LabelNode/PropHost", "only_script_variables": true, "property_filter": "node_list" },
            "expect": {
              "has_keys": ["result"],
              "field_checks": [ { "key": "result", "not_empty": true } ]
            }
          },
          {
            "id": "get_list_script_vars_filter_miss",
            "tool": "property_get_list",
            "args": { "path": "LabelNode/PropHost", "only_script_variables": true, "property_filter": "z_index" },
            "expect": {
              "has_keys": ["result"],
              "field_checks": [ { "key": "result", "value": [] } ]
            }
          },
          {
            "id": "get_list_filter_engine_prop",
            "tool": "property_get_list",
            "args": { "path": "LabelNode", "property_filter": "text" },
            "expect": {
              "has_keys": ["result"],
              "field_checks": [ { "key": "result", "not_empty": true } ]
            }
          },
          {
            "id": "get_list_filter_no_match",
            "tool": "property_get_list",
            "args": { "path": "LabelNode", "property_filter": "no_such_filter_zzz" },
            "expect": {
              "has_keys": ["result"],
              "field_checks": [ { "key": "result", "value": [] } ]
            }
          }
        ]
      },
      {
        "id": "cleanup",
        "steps": [
          {
            "id": "trash_prop_fixture",
            "tool": "move_os_file_to_trash",
            "args": { "path": "res://gda_tmp_prop_refs" },
            "expect": {
              "has_keys": ["result"]
            }
          }
        ]
      }
    ]
  }
}
