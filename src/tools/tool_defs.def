




TOOL_ENTRY(create_scene_node, "create_scene_node", "Create a new node in the edited scene. 'name' (default NewNode), 'type' (default Node, must be a Node subclass); 'parent_path' optional — required when the scene already has a root. Returns the node 'path' and an undo hint.", "Scene", "node,create", scene_ops::handle_create, SCHEMA_BASIC)
TOOL_ENTRY(delete_scene_node, "delete_scene_node", "Delete a node from the edited scene by 'path' via queue_free (deferred removal). Refuses to delete the scene root. Returns 'deleted' with undo info.", "Scene", "node,delete", scene_ops::handle_delete, SCHEMA_BASIC)
TOOL_ENTRY(get_scene_tree, "get_scene_tree", "Walk the node tree of the currently edited scene and return name/type/path/children for each node. Optional 'max_depth' (default 8, -1 unlimited) and 'include_properties' (up to 20 non-metadata properties per node). Returns an error if no scene is open; after switching scenes the listing may briefly reflect the previous scene — call again to refresh.", "Scene", "tree,structure", scene_ops::handle_get_tree, SCHEMA_BASIC)
TOOL_ENTRY(instantiate_scene, "instantiate_scene", "Instantiate a PackedScene ('path') into the edited scene. Optional 'parent_path' (default scene root), 'name' and 'owner' (default true). Returns instance 'path', 'name' and 'type'; note: instances inherit CONNECT_PERSIST connections from the source scene.", "Scene", "scene,instance", scene_ops::handle_instance, SCHEMA_BASIC)


TOOL_ENTRY(property_get, "property_get", "Get a property value from a scene node. Requires 'path' and 'property'; errors if the node or property does not exist (hint to use property_get_list). Returns the serialized value.", "Properties", "property,get", property_ops::handle_get, SCHEMA_BASIC)
TOOL_ENTRY(property_set, "property_set", "Set a property on a scene node. Requires 'path', 'property' and 'value'; optional 'type_hint'. Godot enum values use engine definition order (e.g. CharacterBody2D.motion_mode: GROUNDED=0, FLOATING=1 — query the class enum before setting). Resource values are resolved by path; memory:// resources are rejected to avoid corrupting the scene file. Read-only or invalid assignments error; returns 'ok' with an undo entry (old value) and possible readback warnings.", "Properties", "property,set", property_ops::handle_set, SCHEMA_BASIC)
TOOL_ENTRY(property_get_list, "property_get_list", "List all properties of a scene node. Requires 'path'; returns an array of entries with name, type, hint, hint_string, usage and class_name.", "Properties", "property,list", property_ops::handle_get_list, SCHEMA_BASIC)
TOOL_ENTRY(signal_connect, "signal_connect", "Connect a signal from one node to another. Parameters: 'source_path', 'signal', 'target_path', 'method'. 'persist' (bool, default true) creates the connection with CONNECT_PERSIST so it is saved with the scene and inherited by every instantiation — set false for a runtime-only connection that is not saved. Returns result 'connected' or 'already_connected' (the same signal+callable is already connected; scene instances inherit persistent connections — use signal_disconnect to remove it), plus 'persisted' and a note.", "Properties", "signal,connect", property_ops::handle_signal_connect, SCHEMA_BASIC)
TOOL_ENTRY(signal_disconnect, "signal_disconnect", "Disconnect a signal connection previously established by signal_connect (disconnects signal+callable). Parameters: 'source_path', 'signal', 'target_path', 'method' — same as signal_connect. Returns 'disconnected', or 'not_connected' if the connection does not exist (idempotent — repeated calls are safe).", "Properties", "signal,disconnect", property_ops::handle_signal_disconnect, SCHEMA_BASIC)


TOOL_ENTRY(load_resource, "load_resource", "Load a resource from file path", "Resources", "resource,load", resource_ops::handle_load, SCHEMA_BASIC)
TOOL_ENTRY(load_resource_threaded, "load_resource_threaded", "Start threaded resource load", "Resources", "resource,load,threaded", resource_ops::handle_load_threaded, SCHEMA_BASIC)
