TOOL_ENTRY(remove_resource_file, "remove_resource_file", "Delete a resource file from disk", "Resources", "resource,remove,delete", resource_ops::handle_remove, SCHEMA_BASIC)
TOOL_ENTRY(rename_resource_file, "rename_resource_file", "Rename/move a resource file", "Resources", "resource,rename,move", resource_ops::handle_rename, SCHEMA_BASIC)
TOOL_ENTRY(get_resource_dependencies, "get_resource_dependencies", "List all dependencies of a resource", "Resources", "resource,dependencies,list", resource_ops::handle_get_dependencies, SCHEMA_BASIC)
TOOL_ENTRY(has_resource_dependency, "has_resource_dependency", "Check if a resource depends on another file", "Resources", "resource,dependency,check", resource_ops::handle_has_dependency, SCHEMA_BASIC)

TOOL_ENTRY(reimport_resource_files, "reimport_resource_files", "Reimport one or more resource files (editor only)", "Resources", "resource,reimport", resource_ops::handle_reimport, SCHEMA_BASIC)
TOOL_ENTRY(set_resource_property, "set_resource_property", "Set a property on a resource", "Resources", "resource,property,set", resource_ops::handle_set_property, SCHEMA_BASIC)
TOOL_ENTRY(get_resource_property, "get_resource_property", "Get a property value from a resource", "Resources", "resource,property,get", resource_ops::handle_get_property, SCHEMA_BASIC)


TOOL_ENTRY(execute_script, "execute_script", "Execute arbitrary GDScript code. Single-expression input automatically returns its value; multi-line code requires an explicit return statement. print() output during execution appears in the output field, errors appear in the errors field. Compilation errors include line mapping and the wrapped source. Execution environment exposes SceneRoot (the edited scene root node) for node access; see SceneRoot.get_node('Child').", "Scripts", "script,execute,gdscript", script_ops::handle_execute_gdscript, SCHEMA_BASIC)
TOOL_ENTRY(load_script, "load_script", "Load a script from file path", "Scripts", "script,load", script_ops::handle_load, SCHEMA_BASIC)
TOOL_ENTRY(create_script, "create_script", "Create and save a new GDScript file", "Scripts", "script,create", script_ops::handle_create, SCHEMA_BASIC)
TOOL_ENTRY(attach_script_to_node, "attach_script_to_node", "Attach a script to a scene node", "Scripts", "script,attach,node", script_ops::handle_attach_to_node, SCHEMA_BASIC)
TOOL_ENTRY(detach_script_from_node, "detach_script_from_node", "Detach script from a scene node", "Scripts", "script,detach,node", script_ops::handle_detach_from_node, SCHEMA_BASIC)
TOOL_ENTRY(get_script_property, "get_script_property", "Get a script property's default value or a node's property", "Scripts", "script,property,get", script_ops::handle_get_property, SCHEMA_BASIC)
TOOL_ENTRY(set_script_property, "set_script_property", "Set a property on a node via script", "Scripts", "script,property,set", script_ops::handle_set_property, SCHEMA_BASIC)
TOOL_ENTRY(call_script_node, "call_script_node", "Call a function on a node via its script", "Scripts", "script,call,function", script_ops::handle_call_function, SCHEMA_BASIC)
TOOL_ENTRY(reload_script, "reload_script", "Reload a script from disk", "Scripts", "script,reload", script_ops::handle_reload, SCHEMA_BASIC)
TOOL_ENTRY(get_script_property_list, "get_script_property_list", "List all script variables and their types", "Scripts", "script,variables,list", script_ops::handle_get_variable_list, SCHEMA_BASIC)


