TOOL_ENTRY(set_render_shader_parameter_global, "set_render_shader_parameter_global", "Set a global shader parameter available to all shaders. Requires name (string) and value (any JSON); optional type_hint controls Variant deserialization. Returns 'ok' or an error when required parameters are missing.", "Render", "render,shader", render_ops::handle_global_shader_parameter_set, SCHEMA_NONE)
