TOOL_ENTRY(create_nav_2d_map, "create_nav_2d_map", "Create a 2D navigation map. Optional 'active' (default false) sets the map active. Returns the map RID as 'rid'.", "Navigation", "nav,2d,map,create", nav_ops::handle_2d_map_create, SCHEMA_NONE)
