TOOL_ENTRY(get_debug_object_info, "get_debug_object_info", "Resolve an object instance ID (ObjectID) to its class name and node path", "Debug", "utility,debug,physics", physics_ops::handle_resolve_object, SCHEMA_NONE)


TOOL_ENTRY(create_render_canvas_item, "create_render_canvas_item", "Create a RenderingServer canvas item and return its RID as result.rid. Errors if the RenderingServer is unavailable. Pair with the add_render_canvas_item_* draw tools and set_render_canvas_item_visible.", "Render", "render,canvas,create", render_ops::handle_canvas_item_create, SCHEMA_NONE)
TOOL_ENTRY(add_render_canvas_item_rect, "add_render_canvas_item_rect", "Add a filled rectangle draw command to a canvas item. Requires canvas_item_rid, rect ({position,size}) and color ({r,g,b,a}); optional antialiased (bool, default false). Returns 'ok' or an error when required parameters are missing.", "Render", "render,canvas,draw,rect", render_ops::handle_canvas_item_draw_rect, SCHEMA_NONE)
TOOL_ENTRY(add_render_canvas_item_circle, "add_render_canvas_item_circle", "Add a filled circle draw command to a canvas item. Requires canvas_item_rid, position ({x,y}) and color; optional radius (default 1.0) and antialiased (bool). Returns 'ok' or an error when required parameters are missing.", "Render", "render,canvas,draw,circle", render_ops::handle_canvas_item_draw_circle, SCHEMA_NONE)
TOOL_ENTRY(add_render_canvas_item_texture_rect, "add_render_canvas_item_texture_rect", "Add a textured rectangle draw command to a canvas item. Requires canvas_item_rid, texture_rid and rect; optional tile, modulate (color) and transpose (bool). Returns 'ok' or an error when required parameters are missing.", "Render", "render,canvas,draw,texture", render_ops::handle_canvas_item_draw_texture, SCHEMA_NONE)
TOOL_ENTRY(add_render_canvas_item_line, "add_render_canvas_item_line", "Add a line draw command to a canvas item. Requires canvas_item_rid, from, to and color; optional width (default -1) and antialiased (bool). Returns 'ok' or an error when required parameters are missing.", "Render", "render,canvas,draw,line", render_ops::handle_canvas_item_draw_line, SCHEMA_NONE)
TOOL_ENTRY(set_render_canvas_item_transform, "set_render_canvas_item_transform", "Set the 2D transform of a canvas item. Requires canvas_item_rid; optional x, y (scale axes) and origin_x, origin_y. Returns 'ok' or an error when canvas_item_rid is missing.", "Render", "render,canvas,transform", render_ops::handle_canvas_item_set_transform, SCHEMA_NONE)
TOOL_ENTRY(set_render_canvas_item_visible, "set_render_canvas_item_visible", "Toggle visibility of a canvas item. Requires canvas_item_rid; optional visible (bool, default true). Returns 'ok' or an error when canvas_item_rid is missing.", "Render", "render,canvas,visible", render_ops::handle_canvas_item_set_visible, SCHEMA_NONE)
TOOL_ENTRY(get_render_canvas_item_rid, "get_render_canvas_item_rid", "Get the canvas item RID of a CanvasItem node in the edited scene. Requires path (node path); returns result.rid, or an error if the node is not found or is not a CanvasItem.", "Render", "render,rid,bridge", render_ops::handle_canvas_item_get_rid, SCHEMA_NONE)
TOOL_ENTRY(create_render_scenario, "create_render_scenario", "Create a RenderingServer 3D scenario and return its RID as result.rid. Errors if the RenderingServer is unavailable.", "Render", "render,scenario,create", render_ops::handle_scenario_create, SCHEMA_NONE)
TOOL_ENTRY(set_render_scenario_environment, "set_render_scenario_environment", "Attach an environment RID to a scenario. Requires scenario_rid and environment_rid. Returns 'ok' or an error when required parameters are missing.", "Render", "render,scenario,environment", render_ops::handle_scenario_set_environment, SCHEMA_NONE)
TOOL_ENTRY(create_render_camera, "create_render_camera", "Create a RenderingServer 3D camera and return its RID as result.rid. Errors if the RenderingServer is unavailable.", "Render", "render,camera,create", render_ops::handle_camera_create, SCHEMA_NONE)
TOOL_ENTRY(set_render_camera_transform, "set_render_camera_transform", "Set a 3D camera transform. Only the origin is applied; rotation and scale stay at identity. Requires camera_rid; optional origin_x, origin_y, origin_z. Returns 'ok' or an error when camera_rid is missing.", "Render", "render,camera,transform", render_ops::handle_camera_set_transform, SCHEMA_NONE)
TOOL_ENTRY(set_render_camera_perspective, "set_render_camera_perspective", "Set a perspective projection on a camera. Requires camera_rid; optional fovy_degrees (default 75), z_near (default 0.01) and z_far (default 4000). Returns 'ok' or an error when camera_rid is missing.", "Render", "render,camera,perspective", render_ops::handle_camera_set_perspective, SCHEMA_NONE)
TOOL_ENTRY(set_render_camera_orthogonal, "set_render_camera_orthogonal", "Set an orthogonal projection on a camera. Requires camera_rid; optional size (default 10), z_near (default 0.01) and z_far (default 4000). Returns 'ok' or an error when camera_rid is missing.", "Render", "render,camera,orthogonal", render_ops::handle_camera_set_orthogonal, SCHEMA_NONE)
TOOL_ENTRY(create_render_light, "create_render_light", "Create a RenderingServer light and return its RID as result.rid. Optional type: directional, omni or spot (default directional). Errors on unknown light types or when the RenderingServer is unavailable.", "Render", "render,light,create", render_ops::handle_light_create, SCHEMA_NONE)
TOOL_ENTRY(set_render_light_param, "set_render_light_param", "Set a numeric parameter on a light. Requires light_rid, param (LightParam enum int) and value (float). Returns 'ok' or an error when required parameters are missing.", "Render", "render,light,param", render_ops::handle_light_set_param, SCHEMA_NONE)
TOOL_ENTRY(set_render_light_color, "set_render_light_color", "Set the color of a light. Requires light_rid and color ({r,g,b,a}). Returns 'ok' or an error when required parameters are missing.", "Render", "render,light,color", render_ops::handle_light_set_color, SCHEMA_NONE)
TOOL_ENTRY(create_render_mesh, "create_render_mesh", "Create a RenderingServer mesh and return its RID as result.rid. Errors if the RenderingServer is unavailable.", "Render", "render,mesh,create", render_ops::handle_mesh_create, SCHEMA_NONE)
TOOL_ENTRY(add_render_mesh_surface, "add_render_mesh_surface", "Add a surface built from arrays to a mesh. Requires mesh_rid; optional primitive (PrimitiveType int, default triangles) and arrays (vertices, normals, tangents, colors, uvs, indices). Returns 'ok' or an error when mesh_rid is missing.", "Render", "render,mesh,surface", render_ops::handle_mesh_add_surface, SCHEMA_NONE)
TOOL_ENTRY(set_render_mesh_surface_material, "set_render_mesh_surface_material", "Set a material on a mesh surface. Requires mesh_rid, surface (int) and material_rid. Returns 'ok' or an error when required parameters are missing.", "Render", "render,mesh,material", render_ops::handle_mesh_set_material, SCHEMA_NONE)
TOOL_ENTRY(create_render_material, "create_render_material", "Create a RenderingServer material and return its RID as result.rid. Errors if the RenderingServer is unavailable.", "Render", "render,material,create", render_ops::handle_material_create, SCHEMA_NONE)
TOOL_ENTRY(set_render_material_param, "set_render_material_param", "Set a named parameter on a material. Requires material_rid, parameter (string) and value (any JSON); optional type_hint controls Variant deserialization. Returns 'ok' or an error when required parameters are missing.", "Render", "render,material,param", render_ops::handle_material_set_param, SCHEMA_NONE)
TOOL_ENTRY(create_render_viewport, "create_render_viewport", "Create a RenderingServer viewport and return its RID as result.rid. Errors if the RenderingServer is unavailable.", "Render", "render,viewport,create", render_ops::handle_viewport_create, SCHEMA_NONE)
TOOL_ENTRY(set_render_viewport_size, "set_render_viewport_size", "Set the size of a viewport. Requires viewport_rid; optional width (default 640) and height (default 480). Returns 'ok' or an error when viewport_rid is missing.", "Render", "render,viewport,size", render_ops::handle_viewport_set_size, SCHEMA_NONE)
TOOL_ENTRY(set_render_viewport_clear_mode, "set_render_viewport_clear_mode", "Set the clear mode of a viewport. Requires viewport_rid; optional clear_mode (ViewportClearMode int, default 0). Returns 'ok' or an error when viewport_rid is missing.", "Render", "render,viewport,clear", render_ops::handle_viewport_set_clear_mode, SCHEMA_NONE)
TOOL_ENTRY(create_render_particles, "create_render_particles", "Create a RenderingServer particle system and return its RID as result.rid. Optional mode (ParticlesMode int, default 1 for 3D). Errors if the RenderingServer is unavailable.", "Render", "render,particle,create", render_ops::handle_particle_create, SCHEMA_NONE)
TOOL_ENTRY(set_render_environment_bg_color, "set_render_environment_bg_color", "Set the background color of an environment. Requires environment_rid and color ({r,g,b,a}). Returns 'ok' or an error when required parameters are missing.", "Render", "render,environment,bg", render_ops::handle_environment_set_bg_color, SCHEMA_NONE)
TOOL_ENTRY(set_render_environment_ambient_light, "set_render_environment_ambient_light", "Set the ambient light of an environment. Requires environment_rid and color; optional source and energy. Returns 'ok' or an error when required parameters are missing.", "Render", "render,environment,ambient", render_ops::handle_environment_set_ambient, SCHEMA_NONE)
TOOL_ENTRY(create_render_fog_volume, "create_render_fog_volume", "Create a RenderingServer fog volume and return its RID as result.rid. Optional shape (FogVolumeShape int) and size ({x,y,z}). Errors if the RenderingServer is unavailable.", "Render", "render,fog,create", render_ops::handle_fog_create, SCHEMA_NONE)
TOOL_ENTRY(create_render_shader, "create_render_shader", "Create a RenderingServer shader and return its RID as result.rid. Optional code (string) sets the shader source immediately. Errors if the RenderingServer is unavailable.", "Render", "render,shader,create", render_ops::handle_shader_create, SCHEMA_NONE)


TOOL_ENTRY(create_render_texture_from_image, "create_render_texture_from_image", "Create a server-side 2D texture RID from an image file. Requires image_path; loads the file with Image.load_from_file. Returns result.rid, or an error if the image fails to load.", "Render", "render,texture", render_ops::handle_texture_create_2d, SCHEMA_NONE)
TOOL_ENTRY(set_render_shader_code, "set_render_shader_code", "Set the source code of a shader. Requires shader_rid and code (string). Returns 'ok' or an error when required parameters are missing.", "Render", "render,shader", render_ops::handle_shader_set_code, SCHEMA_NONE)
TOOL_ENTRY(set_render_environment_glow, "set_render_environment_glow", "Configure glow (bloom) on an environment. Requires environment_rid; optional enabled, level, intensity, strength, mix, bloom_threshold, blend_mode, hdr_bleed_threshold, hdr_bleed_scale, hdr_luminance_cap and glow_map_strength. Returns 'ok' or an error when environment_rid is missing.", "Render", "render,environment", render_ops::handle_environment_set_glow, SCHEMA_NONE)
TOOL_ENTRY(set_render_environment_ssr, "set_render_environment_ssr", "Configure screen-space reflections on an environment. Requires environment_rid; optional enabled, max_steps, fade_in, fade_out and depth_tolerance. Returns 'ok' or an error when environment_rid is missing.", "Render", "render,environment", render_ops::handle_environment_set_ssr, SCHEMA_NONE)
TOOL_ENTRY(set_render_environment_tonemap, "set_render_environment_tonemap", "Configure tone mapping on an environment. Requires environment_rid; optional tone_mapper, exposure and white. Returns 'ok' or an error when environment_rid is missing.", "Render", "render,environment", render_ops::handle_environment_set_tonemap, SCHEMA_NONE)
TOOL_ENTRY(set_render_environment_sdfgi, "set_render_environment_sdfgi", "Configure SDFGI global illumination on an environment. Requires environment_rid; optional enabled, cascades, min_cell_size, y_scale, use_occlusion, bounce_feedback, read_sky, energy, normal_bias and probe_bias. Returns 'ok' or an error when environment_rid is missing.", "Render", "render,environment", render_ops::handle_environment_set_sdfgi, SCHEMA_NONE)
TOOL_ENTRY(set_render_environment_volumetric_fog, "set_render_environment_volumetric_fog", "Configure volumetric fog on an environment. Requires environment_rid; optional enabled, density, albedo, emission, emission_energy, anisotropy, length, detail_spread, gi_inject, temporal_reprojection, temporal_reprojection_amount, ambient_inject and sky_affect. Returns 'ok' or an error when environment_rid is missing.", "Render", "render,environment", render_ops::handle_environment_set_volumetric_fog, SCHEMA_NONE)
TOOL_ENTRY(create_render_sky, "create_render_sky", "Create a RenderingServer sky and return its RID as result.rid. Errors if the RenderingServer is unavailable.", "Render", "render,sky", render_ops::handle_sky_create, SCHEMA_NONE)
TOOL_ENTRY(set_render_sky_material, "set_render_sky_material", "Set the material of a sky. Requires sky_rid and material_rid. Returns 'ok' or an error when required parameters are missing.", "Render", "render,sky", render_ops::handle_sky_set_material, SCHEMA_NONE)
TOOL_ENTRY(set_render_particles_emitting, "set_render_particles_emitting", "Set the emitting state of a particle system. Requires particles_rid; optional emitting (bool, default true). Returns 'ok' or an error when particles_rid is missing.", "Render", "render,particles", render_ops::handle_particles_set_emitting, SCHEMA_NONE)
TOOL_ENTRY(restart_render_particles, "restart_render_particles", "Restart a particle system. Requires particles_rid. Returns 'ok' or an error when particles_rid is missing.", "Render", "render,particles", render_ops::handle_particles_restart, SCHEMA_NONE)
TOOL_ENTRY(set_render_particles_lifetime, "set_render_particles_lifetime", "Set the lifetime of a particle system. Requires particles_rid; optional lifetime (float, default 1.0). Returns 'ok' or an error when particles_rid is missing.", "Render", "render,particles", render_ops::handle_particles_set_lifetime, SCHEMA_NONE)
TOOL_ENTRY(create_render_reflection_probe, "create_render_reflection_probe", "Create a RenderingServer reflection probe and return its RID as result.rid. Errors if the RenderingServer is unavailable.", "Render", "render,reflection_probe", render_ops::handle_reflection_probe_create, SCHEMA_NONE)
TOOL_ENTRY(create_render_decal, "create_render_decal", "Create a RenderingServer decal and return its RID as result.rid. Errors if the RenderingServer is unavailable.", "Render", "render,decal", render_ops::handle_decal_create, SCHEMA_NONE)
TOOL_ENTRY(set_render_fog_volume_shape, "set_render_fog_volume_shape", "Set the shape of a fog volume. Requires fog_rid and shape (FogVolumeShape int). Returns 'ok' or an error when required parameters are missing.", "Render", "render,fog", render_ops::handle_fog_volume_set_shape, SCHEMA_NONE)
TOOL_ENTRY(set_render_instance_visible, "set_render_instance_visible", "Toggle visibility of a rendering instance. Requires instance_rid; optional visible (bool, default true). Returns 'ok' or an error when instance_rid is missing.", "Render", "render,instance", render_ops::handle_instance_set_visible, SCHEMA_NONE)
