TOOL_ENTRY(remove_group_node, "remove_group_node", "Remove a scene node from a group. Requires 'node_path' and 'group_name'; registered with the editor undo/redo. Returns 'removed'.", "Group", "group,remove", group_ops::handle_remove_node_from_group, SCHEMA_BASIC)
TOOL_ENTRY(has_group_node, "has_group_node", "Check whether a scene node belongs to a group. Requires 'node_path' and 'group_name'. Returns true or false.", "Group", "group,check", group_ops::handle_has_node_in_group, SCHEMA_BASIC)


TOOL_ENTRY(capture_editor_viewport, "capture_editor_viewport", "Capture the editor viewport as a PNG image, returned as base64-encoded string (target parameter: 'editor' default; 'game' not supported yet)", "Capture", "capture,screenshot,viewport", capture_ops::handle_capture_viewport, SCHEMA_BASIC)


TOOL_ENTRY(get_debugger_log, "get_debugger_log", "Get captured engine log entries (errors and messages); optional int 'limit' caps the result", "Debugger", "debugger,log,output", debugger_ops::handle_output_get_log, SCHEMA_NONE)
TOOL_ENTRY(get_debugger_errors, "get_debugger_errors", "Get errors captured in the running game process (time, file, line, error, description); requires a game running from the editor whose project loads the godot-autopilot extension; data is fetched over the runtime channel; optional int 'limit'", "Debugger", "debugger,errors,stack", debugger_ops::handle_debugger_get_errors, SCHEMA_NONE)
TOOL_ENTRY(get_debugger_output, "get_debugger_output", "Get stdout/stderr output captured in the running game process; requires a game running from the editor whose project loads the godot-autopilot extension; data is fetched over the runtime channel; use get_game_log_entries to read the game process log file instead; optional int 'limit'", "Debugger", "debugger,output,stdout", debugger_ops::handle_debugger_get_output, SCHEMA_NONE)
TOOL_ENTRY(get_debugger_stack_dump, "get_debugger_stack_dump", "Get the most recent stack dump from the debugger; stack data is only available in a debugger breakpoint session and cannot be fetched over the gda runtime channel; use get_game_log_entries or execute_game_script to diagnose", "Debugger", "debugger,stack,dump", debugger_ops::handle_debugger_get_stack_dump, SCHEMA_NONE)
TOOL_ENTRY(get_debugger_scene_tree, "get_debugger_scene_tree", "Get the scene tree of the running game process (node names and types); requires a game running from the editor whose project loads the godot-autopilot extension; data is fetched over the runtime channel", "Debugger", "debugger,scene,tree", debugger_ops::handle_debugger_get_scene_tree, SCHEMA_NONE)
TOOL_ENTRY(get_debugger_monitors, "get_debugger_monitors", "Get performance monitor frames from the debugger; optional int 'count' caps the number of frames", "Debugger", "debugger,monitors,performance", debugger_ops::handle_debugger_get_monitors, SCHEMA_NONE)
TOOL_ENTRY(get_debugger_session_info, "get_debugger_session_info", "Get the current debug session state (active, breaked, running); takes no parameters", "Debugger", "debugger,session,status", debugger_ops::handle_debugger_get_session_info, SCHEMA_NONE)


TOOL_ENTRY(get_game_status, "get_game_status", "Query a running game process (engine version, current scene, node count, FPS) over the runtime debug channel. Requires a game launched from the editor (play_editor_current_scene) whose project loads the godot-autopilot extension. Returns paused (SceneTree pause state) and physics_frame (physics frame counter) to distinguish a fake run; healthy (true when last_activity_ms is less than 3000ms old) and last_activity_ms (millisecond timestamp of the game process's latest activity) to detect liveness/stall. An empty scene with a sharp node_count drop means scene reload (reload_current_scene) may have failed over the debug channel; stop and rerun the game to recover. physics_stalled is true when physics_frame has not advanced, fps>0 and at least 1s elapsed, indicating a frozen physics loop.", "Game", "game,runtime,status,debug", runtime_ops::handle_game_status, SCHEMA_BASIC)
TOOL_ENTRY(execute_game_script, "execute_game_script", "Run code or inspect/modify state inside the running game process over the runtime debug channel. Requires a game launched from the editor (play_editor_current_scene) whose project loads the godot-autopilot extension. action='script' executes arbitrary GDScript (must extend Node and define func _run()); action='get_property'/'set_property'/'call_method' operate on a node by path. timeout_ms is the in-game execution budget; the editor waits budget + 2s grace before reporting a timeout, so an await exceeding the budget returns a clear 'await timed out' error rather than a false 'no listener'. The fallback timeout uses editor-side wall-clock time, unaffected by game time_scale; after a timeout the tool sends an idempotent cancel request (a done_ flag prevents double completion; repeated or already-completed cancels have no side effects) to interrupt the pending await. In-game scripts target Godot 4.7 APIs; outdated methods report Nonexistent function", "Game", "game,runtime,eval,script,debug", runtime_ops::handle_game_eval, SCHEMA_BASIC)
TOOL_ENTRY(queue_game_input, "queue_game_input", "Simulate input inside the running game process over the runtime debug channel (key / mouse_button / action events injected via Input.parse_input_event) — unlike the editor-process input_* tools, the running game receives these events. Requires a game launched from the editor (play_editor_current_scene) whose project loads the godot-autopilot extension. Supported parameters: type (key|mouse_button|action), keycode, pressed, button_index, position, action, duration_ms (auto-release after N ms, only when pressed=true), mode ('event' via parse_input_event — default, 'api' via action_press/action_release — immediate, or 'hold': event-style injection that keeps the input continuously pressed for duration_ms), timeout_ms. Unknown parameters are ignored and reported in the ignored_params field. Transient states (is_action_just_pressed) are visible only in the first physics frame after injection and are lost if the game is paused or physics is frozen (check get_game_input_status's paused/physics_frame fields to diagnose). A press automatically injects a release first to guarantee a fresh just_pressed edge, and the input buffer is flushed (flush_buffered_events) after event injection to remove accumulated latency. Success returns injected_at_physics_frame and expected_visible_frame (= injected frame + 1), plus parsed_physics_frame/parsed_process_frame so the editor can verify the edge was consumed. When paused, a warning is returned that transient edges may not be consumed. For jump-like actions prefer mode='api' with duration_ms, or observe with wait_game_input", "Game", "game,runtime,input,simulate,debug", runtime_ops::handle_game_input, SCHEMA_BASIC)
TOOL_ENTRY(capture_game_viewport, "capture_game_viewport", "Capture the running game's viewport as a PNG image over the runtime debug channel, returned as base64-encoded string — requires a game launched from the editor (play_editor_current_scene) whose project loads the godot-autopilot extension", "Game", "game,runtime,capture,screenshot,debug", runtime_ops::handle_game_capture, SCHEMA_BASIC)
TOOL_ENTRY(wait_game_input, "wait_game_input", "Wait for a transient input state on an action in the running game process over the runtime debug channel. Requires a game launched from the editor (play_editor_current_scene) whose project loads the godot-autopilot extension. state='just_pressed' (default), 'just_released' or 'pressed'; returns when the state is observed in a physics frame or times out (timeout_ms, default 2000, max 30000) — use it to observe is_action_just_pressed effects after queue_game_input injection. Optional inject parameter (object with the same fields as queue_game_input: type/action/keycode/pressed/mode/duration_ms/button_index/position) injects then observes in a single call, avoiding frame skew between separate round trips; note that state=just_pressed/just_released requires inject, since the transient window (1 physics frame) has expired for a standalone call and it always times out", "Game", "game,runtime,input,wait,debug", runtime_ops::handle_game_input_wait, SCHEMA_BASIC)
TOOL_ENTRY(get_game_input_status, "get_game_input_status", "Query the current input state of an action in the running game process over the runtime debug channel (pressed / just_pressed / just_released / physics_frame) — use this to diagnose input injection; requires a game launched from the editor (play_editor_current_scene) whose project loads the godot-autopilot extension", "Game", "game,runtime,input,status,debug", runtime_ops::handle_game_input_status, SCHEMA_BASIC)


TOOL_ENTRY(save_input_map, "save_input_map", "Save the current InputMap to ProjectSettings and write to disk (optional actions whitelist; when omitted, actions prefixed with 'ui_' or containing '/' are filtered out). Persisted actions are loaded by the running game at startup; the editor does not reload project input settings until restart. Verify with ProjectSettings.get_setting('input/<action>').", "Input", "input,map,persist,save", input_map_ops::handle_persist, SCHEMA_BASIC)
