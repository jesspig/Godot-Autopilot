TOOL_ENTRY(create_nav_3d_agent, "create_nav_3d_agent", "Create a 3D navigation agent. Requires 'map_rid' and 'position'; optional 'radius', 'height', 'max_speed' and 'use_3d_avoidance'. Returns the agent RID as 'rid'.", "Navigation", "nav,3d,agent,create", nav_ops::handle_3d_agent_create, SCHEMA_NONE)
TOOL_ENTRY(set_nav_3d_agent_velocity, "set_nav_3d_agent_velocity", "Set the desired velocity of a 3D navigation agent created by create_nav_3d_agent. Requires 'agent_rid' and 'velocity'. Returns true.", "Navigation", "nav,3d,agent,velocity", nav_ops::handle_3d_agent_set_velocity, SCHEMA_NONE)
TOOL_ENTRY(get_nav_3d_agent_state, "get_nav_3d_agent_state", "Get a snapshot of a 3D navigation agent state (despite the old name it returns position and velocity, not the next path position). Requires 'agent_rid'. Returns 'position' and 'velocity'.", "Navigation", "nav,3d,agent,next_path", nav_ops::handle_3d_agent_get_next_path, SCHEMA_NONE)
TOOL_ENTRY(create_nav_3d_obstacle, "create_nav_3d_obstacle", "Create a 3D navigation obstacle. Requires 'map_rid' and 'position'; optional 'radius' and 'height'. Returns the obstacle RID as 'rid'.", "Navigation", "nav,3d,obstacle,create", nav_ops::handle_3d_obstacle_create, SCHEMA_NONE)


