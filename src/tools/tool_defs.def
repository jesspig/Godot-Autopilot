TOOL_ENTRY(get_resource_load_threaded, "get_resource_load_threaded", "Wait for threaded resource load to complete", "Resources", "resource,load,wait", resource_ops::handle_load_threaded_wait, SCHEMA_BASIC)
TOOL_ENTRY(save_resource, "save_resource", "Save a resource to file", "Resources", "resource,save", resource_ops::handle_save, SCHEMA_BASIC)
TOOL_ENTRY(create_resource, "create_resource", "Create a new resource instance by class type", "Resources", "resource,create", resource_ops::handle_create, SCHEMA_BASIC)
TOOL_ENTRY(duplicate_resource, "duplicate_resource", "Duplicate/instance a loaded resource", "Resources", "resource,duplicate", resource_ops::handle_duplicate, SCHEMA_BASIC)
