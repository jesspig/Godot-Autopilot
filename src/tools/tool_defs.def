TOOL_ENTRY(get_resource_extensions, "get_resource_extensions", "Get recognized file extensions for a resource type", "Resources", "resource,extensions", resource_ops::handle_get_extensions, SCHEMA_BASIC)
TOOL_ENTRY(get_resource_dir_files, "get_resource_dir_files", "List resource files in a directory", "Resources", "resource,directory,list", resource_ops::handle_list_dir, SCHEMA_BASIC)
TOOL_ENTRY(get_resource_uid, "get_resource_uid", "Get the UID of a resource file", "Resources", "resource,uid,get", resource_ops::handle_get_uid, SCHEMA_BASIC)
