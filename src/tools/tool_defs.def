TOOL_ENTRY(get_nav_3d_map_path, "get_nav_3d_map_path", "Query a navigation path on a 3D map. Requires 'map_rid', 'origin' and 'destination'; optional 'optimize' (default true) and 'navigation_layers' (default 1). Returns the path as an array of 3D points.", "Navigation", "nav,3d,path,query", nav_ops::handle_3d_path_query, SCHEMA_NONE)
