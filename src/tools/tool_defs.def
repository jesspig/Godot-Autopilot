TOOL_ENTRY(create_nav_3d_region, "create_nav_3d_region", "Create a 3D navigation region on a map. Requires 'map_rid'; optional 'enabled' and 'navigation_layers'. Returns the region RID as 'rid'.", "Navigation", "nav,3d,region,create", nav_ops::handle_3d_region_create, SCHEMA_NONE)
